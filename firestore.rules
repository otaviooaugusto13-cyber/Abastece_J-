rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funções Auxiliares de Autenticação e Perfil ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // --- Coleção: Usuários (Lojas e Promotores/Repositores) ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // O usuário pode criar/atualizar seu próprio documento, mas sem alterar privilégios administrativos
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // --- Coleção: Vagas / Demandas ---
    match /vagas/{vagaId} {
      // Leitura pública para usuários autenticados na plataforma
      allow read: if isAuthenticated();
      
      // Criação permitida apenas para perfis de contratantes (loja)
      allow create: if hasRole('loja') && request.resource.data.lojaId == request.auth.uid;
      
      // Edição/Exclusão apenas pelo proprietário da vaga
      allow update, delete: if hasRole('loja') && resource.data.lojaId == request.auth.uid;
    }

    // --- Coleção: Propostas / Candidaturas ---
    match /propostas/{propostaId} {
      // Apenas a loja dona da vaga ou o promotor candidato podem ler
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.promotorId || 
        request.auth.uid == resource.data.lojaId
      );

      // Promotores podem enviar candidaturas
      allow create: if hasRole('promotor') && request.resource.data.promotorId == request.auth.uid;

      // Atualizações de status da proposta pelas partes envolvidas
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.promotorId || 
        request.auth.uid == resource.data.lojaId
      );
      
      allow delete: if false;
    }

    // --- Coleção: Transações e Pagamentos ---
    match /transacoes/{transacaoId} {
      // Leitura restrita às partes envolvidas na transação
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.promotorId || 
        request.auth.uid == resource.data.lojaId
      );
      
      // Nenhuma escrita direta via cliente (SDK Web).
      // Apenas o backend (Node.js/Firebase Admin SDK) pode processar e alterar saldos/status.
      allow write: if false;
    }
  }
}
